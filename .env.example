# --- MySQL server ---
MYSQL_VERSION=8.4
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_HOST_PORT=3310
# kept low to reproduce connection exhaustion
MYSQL_MAX_CONNECTIONS=20

DB_NAME=appdb
DB_USER=app
DB_PASS=apppass

# --- Where PHP connects (chosen per request: /?mode=direct or /?mode=proxy) ---
# direct: straight to the mysql container on the compose network
DIRECT_DB_HOST=mysql
DIRECT_DB_PORT=3306
# proxy: the Go proxy container on the compose network.
# To use a proxy running on the host instead (go run ./cmd/server), set
# PROXY_DB_HOST=host.docker.internal and stop the proxy container.
PROXY_DB_HOST=proxy
PROXY_DB_PORT=3308

# --- Go proxy container ---
# Max MySQL connections the proxy opens (keep below MYSQL_MAX_CONNECTIONS)
PROXY_POOL_SIZE=10
# How long a query waits for a free backend connection before failing
PROXY_POOL_WAIT=5s
# Host port for connecting to the proxy with a mysql client
PROXY_HOST_PORT=3308

# --- Web ---
APP_HOST_PORT=8086
